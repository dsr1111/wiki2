// Cloudflare Workers 배포 설정
// - npm run build 로 만든 dist/ 폴더(정적 페이지)를 올리고, worker/index.mjs 가 관리자 저장 API 를 맡음
// - 임시 주소: https://dsrwiki.s97716.workers.dev (Cloudflare 의 Worker 이름과 같아야 함)
//
// 비밀값 (코드에 넣지 말고 Cloudflare 대시보드 → Workers → dsrwiki → 설정 → 변수 및 비밀 에 "비밀"로 추가):
//   COUPON_ADMIN_PASSWORD   관리자 비밀번호 (Netlify 와 같은 값)
//   SUPABASE_SECRET_KEY     Supabase secret 키 sb_secret_... (Netlify 와 같은 값)
// 로컬 테스트용 값은 .dev.vars 파일에 (git 에 안 올라감)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsrwiki",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  // 기존 Netlify 함수 코드(node:crypto, Buffer, process.env)를 거의 그대로 쓰기 위함
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /map → map.html 을 보여 주고, /map.html 이나 /map/ 으로 오면 /map 으로 보냄 (기존 주소와 동일)
    "html_handling": "drop-trailing-slash",
    // 없는 주소는 dist/404.html (있으면) 로
    "not_found_handling": "404-page",
    // 이 주소들만 Worker 코드를 거침. 나머지(페이지·이미지·CSS)는 Cloudflare 가 바로 보냄 (무료, 빠름)
    "run_worker_first": ["/api/*", "/robots.txt"]
  },
  // media.dsrwiki.com 이 연결된 R2 버킷 (관리자 저장이 여기에 씀). 예전 Netlify 의 R2_BUCKET 과 같은 이름
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "dsrwiki" },
    // 피드백 첨부 이미지 (비공개: 공개 도메인을 연결하지 말 것. 관리자 로그인 후 /api/feedback 으로만 봄)
    // 배포 전에 Cloudflare 대시보드 → R2 에서 이 이름으로 버킷을 만들어 둬야 함
    { "binding": "FEEDBACK", "bucket_name": "dsrwiki-feedback" }
  ],
  "vars": {
    // 공개 주소라 비밀값 아님 (브라우저 코드 index.js 에도 들어 있음)
    "SUPABASE_URL": "https://mkytwqzrznusjwmcgpgw.supabase.co"
  },
  "observability": { "enabled": true }
}
