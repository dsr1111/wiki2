---
// 모든 페이지가 같이 쓰는 틀 — 기존 HTML 페이지들의 <head> 공통 부분 + 상단 메뉴
// 페이지 CSS 는 각 페이지 맨 위에서 import (빌드 때 압축되어 페이지 HTML 안에 들어감).
// 외부 CSS·스크립트 등 그 밖의 것은 <Fragment slot="head"> 로 넣습니다.
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import '../styles/icons.css';

interface Props {
  /** 탭 제목. 비우면 'DSR WIKI', 넣으면 '덱 | DSR WIKI' 처럼 붙음 */
  title?: string;
  /** 기존 페이지 <body> 에 있던 클래스 (예: 'bg-gray-100') */
  bodyClass?: string;
  /** 기존 페이지 <body> 에 있던 style */
  bodyStyle?: string;
}

const { title, bodyClass, bodyStyle } = Astro.props;
const fullTitle = title ? `${title} | DSR WIKI` : 'DSR WIKI';

// 기존 nav.js 의 initPageClass 와 같은 규칙으로 <body> 클래스를 정함
// (페이지 CSS 가 body.page-xxx 로 구분하는 경우가 있어서 그대로 유지)
const path = Astro.url.pathname;
const PAGE_CLASSES = ['digimon', 'deck', 'evolution', 'map', 'detector', 'overflow', 'calculator', 'exp', 'gacha', 'costume-slot'];
const pageClass = 'page-' + (PAGE_CLASSES.find((p) => path.includes(p)) ?? 'index');
// 페이지 JS 가 "지금 내 페이지인지" 확인하는 이름 (/detail → 'detail', / → 'index').
// 위 클래스는 기존과 같게 두려고 상세 페이지도 page-index 라서 따로 둠
const pageName = path.replace(/^\/|\.html$|\/$/g, '') || 'index';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="/web/static/pretendard.css" />
    <link rel="icon" href="https://media.dsrwiki.com/dsrwiki/icon.webp" type="image/x-icon" />
    <title>{fullTitle}</title>
    <slot name="head" />
    <!--
      PC 스크롤바를 메뉴 아래에서부터 시작하게 그림 (메뉴 옆 칸은 메뉴 색으로 채움).
      - 스크롤바 칸을 항상 둠(overflow-y: scroll): 페이지마다 스크롤이 있고 없고가 달라도
        화면 폭이 같아서 페이지를 옮길 때 메뉴가 좌우로 밀리지 않음 (스크롤할 게 없으면 손잡이만 안 보임)
      - 스크롤바 배경 위쪽(메뉴 높이만큼)은 메뉴 색, 아래는 투명(페이지 배경이 보임), 손잡이는 메뉴 아래에서만 움직임
      - body 에도 같은 규칙: Chrome 은 페이지 스크롤바 모양을 body 의 규칙으로 정하는 경우가 있음 (덱 페이지)
      - 마우스를 쓰는 PC 에서만. 모바일은 스크롤바가 화면 위에 떠서 원래대로 둠
      메뉴 높이: 1118px 미만 2.75rem, 이상 4.75rem (styles1.css 의 custom-nav 와 같음)
    -->
    <style is:inline>
      @media (hover: hover) and (pointer: fine) {
        html { --nav-h: 2.75rem; overflow-y: scroll; scrollbar-gutter: stable; }
        :is(html, body)::-webkit-scrollbar {
          width: 12px;
          background: linear-gradient(var(--black-color, #1d232f) 0 var(--nav-h), rgba(0, 0, 0, 0.06) var(--nav-h), transparent calc(var(--nav-h) + 6px));
        }
        :is(html, body)::-webkit-scrollbar-track { margin-top: var(--nav-h); background: transparent; border-radius: 0; }
        :is(html, body)::-webkit-scrollbar-thumb { background: #c3c8d0; background-clip: padding-box; border: 3px solid transparent; border-radius: 6px; }
        :is(html, body)::-webkit-scrollbar-thumb:hover { background: #9aa1ab; background-clip: padding-box; }
        /* 계산기: 내용이 화면에 딱 맞으면 원래 페이지 스크롤을 껐는데(스크롤바 칸까지 사라져 메뉴가 밀림),
           PC 에서는 스크롤바 칸을 그대로 둠. 넘치는 게 없으니 손잡이는 안 보이고 스크롤도 안 됨 */
        /* 페이지 CSS 가 이 블록보다 뒤에 들어가므로(빌드 때 HTML 에 넣는 위치) :root 로 우선순위를 높여 둠 */
        :root.calculator-fits-viewport { overflow-y: scroll; }
      }
      @media (hover: hover) and (pointer: fine) and (min-width: 1118px) {
        html { --nav-h: 4.75rem; }
      }
    </style>

    <!-- 구글 애널리틱스: 페이지 이동(주소 변경)은 GA4 가 자동으로 집계함 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-V5VLCXSKM7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-V5VLCXSKM7');
    </script>

    <!-- 페이지 이동 시 새로 고침 없이 본문만 바꿔 끼움 (메뉴는 그대로 유지) -->
    <ClientRouter />
  </head>
  <body class={[pageClass, bodyClass].filter(Boolean).join(' ')} style={bodyStyle} data-page={pageName}>
    <Nav />
    <slot />
    <script>
      import '../scripts/lazyload.js';
      import '../scripts/css-swap.js';
    </script>
  </body>
</html>
