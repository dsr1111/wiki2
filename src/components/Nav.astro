---
// 상단 메뉴 (흰색 바 + 펼치면 화면 폭 전체에 그룹별 4칸 패널)
// - 디자인이 페이지 CSS 와 섞이지 않도록 shadow DOM 안에 둠.
//   HTML 에 바로 넣어서(Declarative Shadow DOM) 처음부터 완성된 메뉴가 보임
// - 메뉴 CSS 를 HTML 안에 넣어 두므로, CSS 를 기다리느라 메뉴를 숨겨 두는 처리가 필요 없음
// - transition:persist: 페이지를 옮겨도 메뉴는 그대로 두고 본문만 바뀜
// - 높이는 예전과 같음 (모바일 44px, 1118px 이상 76px). 페이지들이 이 높이에 맞춰 위쪽을 비워 둠
import baseCss from '../styles/styles1.css?raw';
import navCss from '../styles/nav-menu.css?raw'; // 메뉴 전용 규칙 (페이지에는 안 들어감)
import feedbackCss from '../styles/feedback.css?raw'; // 피드백 창

// en: 영어로 볼 때 쓰는 이름 (게임 영어판에 있는 말은 그대로)
type Item = { label: string; en: string; href: string; external?: boolean };
type Group = { label: string; en: string; items: Item[] };

const GROUPS: Group[] = [
  {
    label: '디지몬', en: 'Digimon',
    items: [
      { label: '도감', en: 'Digidex', href: '/digimon' },
      { label: '덱', en: 'Deck', href: '/deck' },
      { label: '진화트리', en: 'Evolution Tree', href: '/evolution' },
      { label: '맵', en: 'Map', href: '/map' },
      { label: '퀘스트', en: 'Quest', href: '/quest' },
    ],
  },
  {
    label: '던전', en: 'Dungeon',
    items: [
      { label: '탐지기', en: 'Detector', href: '/detector' },
      { label: '오버플로우', en: 'Overflow', href: '/overflow' },
    ],
  },
  {
    label: '도구', en: 'Tools',
    items: [
      { label: '데미지 계산기', en: 'Damage Calculator', href: '/calculator' },
      { label: 'EXP 물약 시뮬레이터', en: 'EXP Potion Simulator', href: '/exp' },
      { label: '가챠 시뮬레이터', en: 'Gacha Simulator', href: '/gacha' },
      { label: '코스튬 슬롯 각인', en: 'Costume Slot Mod', href: '/costume-slot' },
    ],
  },
  {
    label: '사이트', en: 'Links',
    items: [
      { label: '공식 홈페이지', en: 'Official Website', href: 'https://www.digimonsuperrumble.com/', external: true },
      { label: '공식 카페', en: 'Official Cafe', href: 'https://cafe.naver.com/movedsr', external: true },
    ],
  },
];

// 피드백 버튼은 사이트 안의 피드백 창(아래 <dialog>, scripts/feedback.ts)을 엶.
// 구글폼 주소는 스크립트가 안 돌 때와 전송이 실패했을 때 대신 쓰는 곳
const FEEDBACK_URL = 'https://forms.gle/7xSaJBz4A28CPY4z9';

// styles1.css 맨 위의 글꼴 @import 는 페이지에서 이미 불러오므로 메뉴 안에서는 뺌
const shadowCss = baseCss.replace(/@import[^;]+;/g, '') + navCss + feedbackCss;
---
<custom-nav transition:persist="site-nav">
  <template shadowrootmode="open">
    <style set:html={shadowCss}></style>

    <header class="bar">
      <div class="bar__in">
        <!-- 로고: 디지바이스(탭 아이콘과 같은 그림, public/logo-digivice.png) + 글자. 예전 게임 로고 이미지는 media.dsrwiki.com/dsrwiki/logo2.webp -->
        <a href="/" class="bar__home">
          <img src="/logo-digivice.png" class="bar__logo" alt="" width="34" height="34" fetchpriority="high" />
          <span class="bar__name">DSR WIKI</span>
        </a>

        <nav class="bar__nav" aria-label="주 메뉴">
          {GROUPS.map((group, i) => (
            <button type="button" class="bar__top" data-col={i} aria-expanded="false" data-en={group.en}>{group.label}</button>
          ))}
        </nav>

        <div class="bar__end">
          <!-- 화면 모드: 해(라이트) · 달(다크) · 모니터(기기 설정 따르기, 기본값). 동그라미가 고른 쪽에 있음 -->
          <div class="bar__theme" role="radiogroup" aria-label="화면 모드" data-mode="system">
            <span class="bar__knob" aria-hidden="true"></span>
            <button type="button" role="radio" data-mode="light" aria-checked="false" aria-label="라이트 모드" title="라이트 모드"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
            <button type="button" role="radio" data-mode="dark" aria-checked="false" aria-label="다크 모드" title="다크 모드"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></button>
            <button type="button" role="radio" data-mode="system" aria-checked="true" aria-label="기기 설정 따르기" title="기기 설정 따르기"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg></button>
          </div>
          <!-- 언어: 한국어 · 영어 (scripts/i18n.js). 고른 쪽에 동그라미 -->
          <div class="bar__lang" role="radiogroup" aria-label="언어 / Language" data-lang="ko">
            <span class="bar__knob" aria-hidden="true"></span>
            <button type="button" role="radio" data-lang="ko" aria-checked="true" title="한국어">한</button>
            <button type="button" role="radio" data-lang="en" aria-checked="false" title="English">EN</button>
          </div>
          <a class="bar__fb" href={FEEDBACK_URL} target="_blank" rel="noopener" data-feedback data-en="Feedback">피드백</a>
          <button type="button" class="bar__menu" aria-expanded="false">메뉴</button>
        </div>
      </div>

      <div class="panel">
        <div class="panel__cols">
          {GROUPS.map((group) => (
            <div class="panel__col">
              <h3 data-en={group.en}>{group.label}</h3>
              {group.items.map((item) =>
                item.external ? (
                  <a class="panel__item" href={item.href} target="_blank" rel="noopener" data-en={item.en}>{item.label}</a>
                ) : (
                  <a class="panel__item" href={item.href} data-en={item.en}>{item.label}</a>
                ),
              )}
            </div>
          ))}
          <a class="panel__fb" href={FEEDBACK_URL} target="_blank" rel="noopener" data-feedback data-en="Send Feedback">피드백 보내기</a>
        </div>
      </div>
    </header>

    <!-- 피드백 창: 메뉴 색 변수를 같이 써서 다크 모드도 메뉴와 같이 바뀜. 동작은 scripts/feedback.ts -->
    <dialog class="fbk" aria-labelledby="fbk-title" data-fallback={FEEDBACK_URL}>
      <form class="fbk__form" novalidate>
        <div class="fbk__head">
          <h2 id="fbk-title">피드백 보내기</h2>
          <button type="button" class="fbk__x" data-close aria-label="닫기"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>
        <p class="fbk__lead">잘못된 정보나 오류, 있었으면 하는 기능을 알려 주세요. 보낸 내용은 운영자만 봐요.</p>

        <fieldset class="fbk__kinds">
          <legend class="fbk__label">종류</legend>
          <label><input type="radio" name="category" value="bug" checked /><span>오류 제보</span></label>
          <label><input type="radio" name="category" value="idea" /><span>건의</span></label>
          <label><input type="radio" name="category" value="etc" /><span>기타</span></label>
        </fieldset>

        <label class="fbk__field">
          <span class="fbk__label">내용</span>
          <textarea name="message" rows="6" maxlength="2000" placeholder="어느 페이지에서 무엇이 어떻게 됐는지 적어 주시면 빨리 고칠 수 있어요."></textarea>
          <span class="fbk__count" aria-live="polite">0 / 2000</span>
        </label>

        <div class="fbk__field">
          <span class="fbk__label">이미지 <small>선택, 3장까지. 캡처한 화면을 붙여넣어도 돼요</small></span>
          <div class="fbk__shots">
            <label class="fbk__add">
              <input type="file" accept="image/png,image/jpeg,image/webp,image/gif" multiple />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              <span>이미지 추가</span>
            </label>
          </div>
        </div>

        <label class="fbk__field">
          <span class="fbk__label">연락처 <small>선택. 답변이 필요하면 디스코드 아이디 등</small></span>
          <input type="text" name="contact" maxlength="100" autocomplete="off" />
        </label>

        <!-- 사람 눈에는 안 보이는 칸: 봇이 채우면 서버가 저장하지 않음 -->
        <input class="fbk__hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <p class="fbk__error" role="alert"></p>
        <div class="fbk__foot">
          <button type="button" class="fbk__btn" data-close>취소</button>
          <button type="submit" class="fbk__btn fbk__btn--main">보내기</button>
        </div>
      </form>

      <div class="fbk__done" hidden>
        <h2>보냈어요</h2>
        <p>알려 주셔서 고마워요. 확인하고 반영할게요.</p>
        <div class="fbk__foot"><button type="button" class="fbk__btn fbk__btn--main" data-close>닫기</button></div>
      </div>
    </dialog>
  </template>
</custom-nav>

<script>
  import { prefetch } from 'astro:prefetch';
  import { initFeedback } from '../scripts/feedback';
  import { getLang, setLang } from '../scripts/i18n.js';

  const host = document.querySelector('custom-nav') as HTMLElement | null;

  // 아주 오래된 브라우저(Declarative Shadow DOM 미지원)용: <template> 을 직접 shadow DOM 으로 붙임
  if (host && !host.shadowRoot) {
    const tpl = host.querySelector('template[shadowrootmode]') as HTMLTemplateElement | null;
    if (tpl) {
      host.attachShadow({ mode: 'open' }).appendChild(tpl.content);
      tpl.remove();
    }
  }

  const root = host?.shadowRoot;
  if (root) {
    const bar = root.querySelector('.bar') as HTMLElement;
    const panel = root.querySelector('.panel') as HTMLElement;
    const tops = [...root.querySelectorAll<HTMLButtonElement>('.bar__top')];
    const cols = [...root.querySelectorAll<HTMLElement>('.panel__col')];
    const menuBtn = root.querySelector('.bar__menu') as HTMLButtonElement;

    /* PC: 그룹에 마우스를 올리거나 누르면 패널이 열리고, 그 그룹 칸만 진하게 보임 */
    const openCol = (i: number | null) => {
      tops.forEach((t, j) => t.setAttribute('aria-expanded', String(j === i)));
      cols.forEach((c, j) => c.classList.toggle('dim', i !== null && j !== i));
    };
    let closeTimer = 0;
    tops.forEach((t, i) => {
      t.addEventListener('mouseenter', () => { clearTimeout(closeTimer); openCol(i); });
      t.addEventListener('click', () => openCol(i));
      t.addEventListener('focus', () => openCol(i));
    });
    bar.addEventListener('mouseleave', () => {
      closeTimer = window.setTimeout(() => openCol(null), 120);
    });
    panel.addEventListener('mouseenter', () => clearTimeout(closeTimer));

    /* 언어: 영어면 메뉴 글자를 data-en 으로 바꿈. 버튼을 누르면 기억하고 페이지를 다시 불러옴 */
    const lang = getLang();
    const langBox = root.querySelector('.bar__lang') as HTMLElement;
    langBox.dataset.lang = lang;
    langBox.querySelectorAll<HTMLButtonElement>('[role="radio"]').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.lang === lang));
      b.addEventListener('click', () => { if (b.dataset.lang !== getLang()) setLang(b.dataset.lang as string); });
    });
    if (lang === 'en') {
      root.querySelectorAll<HTMLElement>('[data-en]').forEach((el) => { el.textContent = el.dataset.en as string; });
      menuBtn.textContent = 'Menu';
    }

    /* 모바일: 메뉴 버튼으로 전체 목록 열고 닫기 */
    const setMobile = (open: boolean) => {
      bar.classList.toggle('open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.textContent = getLang() === 'en' ? (open ? 'Close' : 'Menu') : (open ? '닫기' : '메뉴');
    };
    menuBtn.addEventListener('click', () => setMobile(!bar.classList.contains('open')));

    const closeAll = () => { openCol(null); setMobile(false); };

    /* 피드백 버튼 → 사이트 안의 피드백 창 (스크립트가 안 돌면 링크대로 구글폼이 열림) */
    const feedback = initFeedback(root);
    root.querySelectorAll<HTMLAnchorElement>('[data-feedback]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (!feedback) return;
        e.preventDefault();
        closeAll();
        feedback.open();
      });
    });

    // 페이지 안의 버튼에서도 피드백 창을 열 수 있게 (예: 맵의 드랍 제보 버튼). detail.text = 미리 채울 글
    document.addEventListener('dsr:feedback', (e) => {
      const text = (e as CustomEvent<{ text?: string }>).detail?.text;
      if (feedback) { closeAll(); feedback.open(text); }
      else window.open(root.querySelector<HTMLElement>('dialog.fbk')?.dataset.fallback || 'https://forms.gle/7xSaJBz4A28CPY4z9', '_blank', 'noopener');
    });

    /* 바깥을 누르거나 Esc 를 누르면 닫기 */
    document.addEventListener('click', (e) => {
      if (!e.composedPath().includes(bar)) closeAll();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });

    /* 화면 모드: light / system / dark (처음 값은 Layout.astro 의 head 스크립트가 정해 둠)
       - light·dark 는 localStorage 'theme' 에 기억, system 은 기억을 지우고 기기 설정을 따름
       - system 일 때 기기 설정이 바뀌면 head 스크립트가 data-theme 을 바꿔 줌 */
    const themeBox = root.querySelector('.bar__theme') as HTMLElement;
    const themeRadios = [...themeBox.querySelectorAll<HTMLButtonElement>('[role="radio"]')];
    const darkQuery = matchMedia('(prefers-color-scheme: dark)');
    const savedMode = () => {
      try { const t = localStorage.getItem('theme'); return t === 'light' || t === 'dark' ? t : 'system'; } catch { return 'system'; }
    };
    const syncTheme = () => {
      const mode = savedMode();
      themeBox.dataset.mode = mode;
      themeRadios.forEach((r) => {
        const on = r.dataset.mode === mode;
        r.setAttribute('aria-checked', String(on));
        r.tabIndex = on ? 0 : -1;
      });
    };
    const setMode = (mode: string) => {
      try {
        if (mode === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', mode);
      } catch {}
      document.documentElement.dataset.theme = mode === 'system' ? (darkQuery.matches ? 'dark' : 'light') : mode;
      syncTheme();
    };
    themeRadios.forEach((r, i) => {
      r.addEventListener('click', () => setMode(r.dataset.mode!));
      // 키보드: 좌우 화살표로 옮겨 고름 (라디오 묶음 규칙)
      r.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = themeRadios[(i + step + themeRadios.length) % themeRadios.length];
        setMode(next.dataset.mode!);
        next.focus();
      });
    });
    syncTheme();

    /* 지금 있는 페이지 표시: 그 메뉴 글자색 + 그 그룹 밑줄 */
    const markCurrent = () => {
      const path = location.pathname.replace(/\/$/, '') || '/';
      root.querySelectorAll<HTMLAnchorElement>('.panel__item').forEach((a) => {
        if (a.getAttribute('href') === path) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
      cols.forEach((c, i) => tops[i].classList.toggle('is-here', !!c.querySelector('[aria-current]')));
    };
    markCurrent();

    /* 다른 페이지로 넘어가면 열려 있던 메뉴를 닫고 현재 페이지 표시를 바꿈 */
    document.addEventListener('astro:after-swap', () => {
      closeAll();
      markCurrent();
      (root.activeElement as HTMLElement | null)?.blur();
    });

    /* 다음 페이지 미리 받기: Astro 의 자동 미리 받기는 shadow DOM 안의 링크를 못 보므로 여기서 직접 호출 */
    const linkOf = (e: Event) =>
      (e.target as Element).closest?.('a[href^="/"]') as HTMLAnchorElement | null;
    root.addEventListener('pointerover', (e) => {
      const a = linkOf(e);
      if (a) prefetch(a.getAttribute('href')!);
    }, { passive: true });
    root.addEventListener('touchstart', (e) => {
      const a = linkOf(e);
      if (a) prefetch(a.getAttribute('href')!, { ignoreSlowConnection: true });
    }, { passive: true });

    // 첫 화면이 다 뜨고 한가할 때 메뉴의 모든 페이지를 미리 받아 둠 (전부 합쳐 압축 80KB 정도).
    // 마우스를 올리자마자 바로 누를 때도 기다림 없이 바로 넘어가게 하려는 것.
    // CSS 는 각 페이지 HTML 안에 들어 있으므로 HTML 만 받으면 됨.
    // 데이터 절약 모드·느린 회선(2g)에서는 하지 않음. Astro 의 prefetch 라 같은 페이지는 다시 안 받음.
    // 터치 기기(폰·태블릿)에서도 하지 않음: 모바일 데이터 부담. 대신 위의 touchstart 미리 받기가 누르는 순간 그 페이지만 받음.
    const prefetchMenu = () => {
      const conn = (navigator as any).connection;
      if (conn?.saveData || /2g/.test(conn?.effectiveType ?? '')) return;
      if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      root.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach((a) => {
        const href = a.getAttribute('href')!;
        if (href !== location.pathname) prefetch(href, { ignoreSlowConnection: true });
      });
    };
    const idle = (fn: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 4000 }) : setTimeout(fn, 2000);
    if (document.readyState === 'complete') idle(prefetchMenu);
    else window.addEventListener('load', () => idle(prefetchMenu), { once: true });
  }
</script>
