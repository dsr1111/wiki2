---
// 상단 메뉴 (흰색 바 + 펼치면 화면 폭 전체에 그룹별 4칸 패널)
// - 디자인이 페이지 CSS 와 섞이지 않도록 shadow DOM 안에 둠.
//   HTML 에 바로 넣어서(Declarative Shadow DOM) 처음부터 완성된 메뉴가 보임
// - 메뉴 CSS 를 HTML 안에 넣어 두므로, CSS 를 기다리느라 메뉴를 숨겨 두는 처리가 필요 없음
// - transition:persist: 페이지를 옮겨도 메뉴는 그대로 두고 본문만 바뀜
// - 높이는 예전과 같음 (모바일 44px, 1118px 이상 76px). 페이지들이 이 높이에 맞춰 위쪽을 비워 둠
import baseCss from '../styles/styles1.css?raw';
import navCss from '../styles/nav-menu.css?raw'; // 메뉴 전용 규칙 (페이지에는 안 들어감)

type Item = { label: string; href: string; external?: boolean };
type Group = { label: string; items: Item[] };

const GROUPS: Group[] = [
  {
    label: '디지몬',
    items: [
      { label: '도감', href: '/digimon' },
      { label: '덱', href: '/deck' },
      { label: '진화트리', href: '/evolution' },
      { label: '맵', href: '/map' },
    ],
  },
  {
    label: '던전',
    items: [
      { label: '탐지기', href: '/detector' },
      { label: '오버플로우', href: '/overflow' },
    ],
  },
  {
    label: '도구',
    items: [
      { label: '데미지 계산기', href: '/calculator' },
      { label: 'EXP 물약 시뮬레이터', href: '/exp' },
      { label: '가챠 시뮬레이터', href: '/gacha' },
      { label: '코스튬 슬롯 각인', href: '/costume-slot' },
    ],
  },
  {
    label: '사이트',
    items: [
      { label: '공식 홈페이지', href: 'https://www.digimonsuperrumble.com/', external: true },
      { label: '공식 카페', href: 'https://cafe.naver.com/movedsr', external: true },
    ],
  },
];

const FEEDBACK_URL = 'https://forms.gle/7xSaJBz4A28CPY4z9';

// styles1.css 맨 위의 글꼴 @import 는 페이지에서 이미 불러오므로 메뉴 안에서는 뺌
const shadowCss = baseCss.replace(/@import[^;]+;/g, '') + navCss;
---
<custom-nav transition:persist="site-nav">
  <template shadowrootmode="open">
    <style set:html={shadowCss}></style>

    <header class="bar">
      <div class="bar__in">
        <a href="/" class="bar__home">
          <img src="https://media.dsrwiki.com/dsrwiki/logo2.webp" class="bar__logo" alt="DSR WIKI" fetchpriority="high" />
        </a>

        <nav class="bar__nav" aria-label="주 메뉴">
          {GROUPS.map((group, i) => (
            <button type="button" class="bar__top" data-col={i} aria-expanded="false">{group.label}</button>
          ))}
        </nav>

        <div class="bar__end">
          <button type="button" class="bar__theme" aria-pressed="false" aria-label="다크 모드" title="다크 모드">
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
          <a class="bar__fb" href={FEEDBACK_URL} target="_blank" rel="noopener">피드백</a>
          <button type="button" class="bar__menu" aria-expanded="false">메뉴</button>
        </div>
      </div>

      <div class="panel">
        <div class="panel__cols">
          {GROUPS.map((group) => (
            <div class="panel__col">
              <h3>{group.label}</h3>
              {group.items.map((item) =>
                item.external ? (
                  <a class="panel__item" href={item.href} target="_blank" rel="noopener">{item.label}</a>
                ) : (
                  <a class="panel__item" href={item.href}>{item.label}</a>
                ),
              )}
            </div>
          ))}
          <a class="panel__fb" href={FEEDBACK_URL} target="_blank" rel="noopener">피드백 보내기</a>
        </div>
      </div>
    </header>
  </template>
</custom-nav>

<script>
  import { prefetch } from 'astro:prefetch';

  const host = document.querySelector('custom-nav') as HTMLElement | null;

  // 아주 오래된 브라우저(Declarative Shadow DOM 미지원)용: <template> 을 직접 shadow DOM 으로 붙임
  if (host && !host.shadowRoot) {
    const tpl = host.querySelector('template[shadowrootmode]') as HTMLTemplateElement | null;
    if (tpl) {
      host.attachShadow({ mode: 'open' }).appendChild(tpl.content);
      tpl.remove();
    }
  }

  const root = host?.shadowRoot;
  if (root) {
    const bar = root.querySelector('.bar') as HTMLElement;
    const panel = root.querySelector('.panel') as HTMLElement;
    const tops = [...root.querySelectorAll<HTMLButtonElement>('.bar__top')];
    const cols = [...root.querySelectorAll<HTMLElement>('.panel__col')];
    const menuBtn = root.querySelector('.bar__menu') as HTMLButtonElement;

    /* PC: 그룹에 마우스를 올리거나 누르면 패널이 열리고, 그 그룹 칸만 진하게 보임 */
    const openCol = (i: number | null) => {
      tops.forEach((t, j) => t.setAttribute('aria-expanded', String(j === i)));
      cols.forEach((c, j) => c.classList.toggle('dim', i !== null && j !== i));
    };
    let closeTimer = 0;
    tops.forEach((t, i) => {
      t.addEventListener('mouseenter', () => { clearTimeout(closeTimer); openCol(i); });
      t.addEventListener('click', () => openCol(i));
      t.addEventListener('focus', () => openCol(i));
    });
    bar.addEventListener('mouseleave', () => {
      closeTimer = window.setTimeout(() => openCol(null), 120);
    });
    panel.addEventListener('mouseenter', () => clearTimeout(closeTimer));

    /* 모바일: 메뉴 버튼으로 전체 목록 열고 닫기 */
    const setMobile = (open: boolean) => {
      bar.classList.toggle('open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.textContent = open ? '닫기' : '메뉴';
    };
    menuBtn.addEventListener('click', () => setMobile(!bar.classList.contains('open')));

    const closeAll = () => { openCol(null); setMobile(false); };

    /* 바깥을 누르거나 Esc 를 누르면 닫기 */
    document.addEventListener('click', (e) => {
      if (!e.composedPath().includes(bar)) closeAll();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });

    /* 다크/라이트 전환 (처음 값은 Layout.astro 의 head 스크립트가 정해 둠) */
    const themeBtn = root.querySelector('.bar__theme') as HTMLButtonElement;
    const syncTheme = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      themeBtn.setAttribute('aria-pressed', String(dark));
      const label = dark ? '라이트 모드' : '다크 모드';
      themeBtn.setAttribute('aria-label', label);
      themeBtn.title = label;
    };
    themeBtn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      syncTheme();
    });
    // 기기 설정이 바뀌어 head 스크립트가 테마를 바꿀 때도 아이콘을 맞춤
    new MutationObserver(syncTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    syncTheme();

    /* 지금 있는 페이지 표시: 그 메뉴 글자색 + 그 그룹 밑줄 */
    const markCurrent = () => {
      const path = location.pathname.replace(/\/$/, '') || '/';
      root.querySelectorAll<HTMLAnchorElement>('.panel__item').forEach((a) => {
        if (a.getAttribute('href') === path) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
      cols.forEach((c, i) => tops[i].classList.toggle('is-here', !!c.querySelector('[aria-current]')));
    };
    markCurrent();

    /* 다른 페이지로 넘어가면 열려 있던 메뉴를 닫고 현재 페이지 표시를 바꿈 */
    document.addEventListener('astro:after-swap', () => {
      closeAll();
      markCurrent();
      (root.activeElement as HTMLElement | null)?.blur();
    });

    /* 다음 페이지 미리 받기: Astro 의 자동 미리 받기는 shadow DOM 안의 링크를 못 보므로 여기서 직접 호출 */
    const linkOf = (e: Event) =>
      (e.target as Element).closest?.('a[href^="/"]') as HTMLAnchorElement | null;
    root.addEventListener('pointerover', (e) => {
      const a = linkOf(e);
      if (a) prefetch(a.getAttribute('href')!);
    }, { passive: true });
    root.addEventListener('touchstart', (e) => {
      const a = linkOf(e);
      if (a) prefetch(a.getAttribute('href')!, { ignoreSlowConnection: true });
    }, { passive: true });

    // 첫 화면이 다 뜨고 한가할 때 메뉴의 모든 페이지를 미리 받아 둠 (전부 합쳐 압축 80KB 정도).
    // 마우스를 올리자마자 바로 누를 때도 기다림 없이 바로 넘어가게 하려는 것.
    // CSS 는 각 페이지 HTML 안에 들어 있으므로 HTML 만 받으면 됨.
    // 데이터 절약 모드·느린 회선(2g)에서는 하지 않음. Astro 의 prefetch 라 같은 페이지는 다시 안 받음.
    // 터치 기기(폰·태블릿)에서도 하지 않음: 모바일 데이터 부담. 대신 위의 touchstart 미리 받기가 누르는 순간 그 페이지만 받음.
    const prefetchMenu = () => {
      const conn = (navigator as any).connection;
      if (conn?.saveData || /2g/.test(conn?.effectiveType ?? '')) return;
      if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      root.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach((a) => {
        const href = a.getAttribute('href')!;
        if (href !== location.pathname) prefetch(href, { ignoreSlowConnection: true });
      });
    };
    const idle = (fn: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 4000 }) : setTimeout(fn, 2000);
    if (document.readyState === 'complete') idle(prefetchMenu);
    else window.addEventListener('load', () => idle(prefetchMenu), { once: true });
  }
</script>
