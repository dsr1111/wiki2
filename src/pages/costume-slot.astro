---
// 기존 costume-slot.html 을 옮긴 페이지
import Layout from '../layouts/Layout.astro';
// CSS 는 빌드할 때 압축해서 페이지 안에 넣음 (순서 = 예전 <link> 순서 그대로)
import '../styles/styles1.css';
import '../styles/pages/costume-slot/main.css';
import '../styles/tw/costume-slot.css';
---
<Layout title="코스튬 슬롯 각인 시뮬레이터" bodyClass="bg-gray-100" bodyStyle="font-family: 'Pretendard', sans-serif;">

    <div class="mt-20 md:mt-28">
        <div class="container mx-auto px-4">
            <div class="mb-8">
                <div class="ce-modal-overlay">
                    <div class="ce-modal">
                        <button class="ce-close-btn"><i class="ri-close-line"></i></button>

                        <div class="ce-title-wrap">
                            <h2 class="ce-title" data-en="Costume Slot Mod">코스튬 슬롯 각인</h2>
                        </div>

                        <div class="ce-tabs-wrap">
                            <div class="ce-tabs">
                                <button class="ce-tab active" data-en="Stat mod">능력치 각인</button>
                                <button class="ce-tab inactive" data-en="Value mod">수치 각인</button>
                            </div>
                            <button class="ce-stats-btn" id="ce-stats-btn"><i class="ri-bar-chart-fill"></i> <span data-en="Statistics">통계</span></button>
                        </div>

                        <div class="ce-layout">
                            <!-- Left Sidebar (Slots) -->
                            <div class="ce-sidebar">
                                <button class="ce-slot-btn active" data-slot="머리 슬롯">
                                    <div class="ce-slot-icon-box"><img
                                            src="https://media.dsrwiki.com/dsrwiki/item/머리 슬롯.webp" class="ce-slot-img"
                                            alt="머리 슬롯"></div>
                                    <span class="ce-slot-text" data-en="Head Slot">머리 슬롯</span>
                                </button>
                                <button class="ce-slot-btn" data-slot="얼굴 슬롯">
                                    <div class="ce-slot-icon-box"><img
                                            src="https://media.dsrwiki.com/dsrwiki/item/얼굴 슬롯.webp" class="ce-slot-img"
                                            alt="얼굴 슬롯"></div>
                                    <span class="ce-slot-text" data-en="Face Slot">얼굴 슬롯</span>
                                </button>
                                <button class="ce-slot-btn" data-slot="상의 슬롯">
                                    <div class="ce-slot-icon-box"><img
                                            src="https://media.dsrwiki.com/dsrwiki/item/상의 슬롯.webp" class="ce-slot-img"
                                            alt="상의 슬롯"></div>
                                    <span class="ce-slot-text" data-en="Top Slot">상의 슬롯</span>
                                </button>
                                <button class="ce-slot-btn" data-slot="장갑 슬롯">
                                    <div class="ce-slot-icon-box"><img
                                            src="https://media.dsrwiki.com/dsrwiki/item/장갑 슬롯.webp" class="ce-slot-img"
                                            alt="장갑 슬롯"></div>
                                    <span class="ce-slot-text" data-en="Gloves Slot">장갑 슬롯</span>
                                </button>
                                <button class="ce-slot-btn" data-slot="하의 슬롯">
                                    <div class="ce-slot-icon-box"><img
                                            src="https://media.dsrwiki.com/dsrwiki/item/하의 슬롯.webp" class="ce-slot-img"
                                            alt="하의 슬롯"></div>
                                    <span class="ce-slot-text" data-en="Bottom Slot">하의 슬롯</span>
                                </button>
                                <button class="ce-slot-btn" data-slot="양말 슬롯">
                                    <div class="ce-slot-icon-box"><img
                                            src="https://media.dsrwiki.com/dsrwiki/item/양말 슬롯.webp" class="ce-slot-img"
                                            alt="양말 슬롯"></div>
                                    <span class="ce-slot-text" data-en="Socks Slot">양말 슬롯</span>
                                </button>
                                <button class="ce-slot-btn" data-slot="신발 슬롯">
                                    <div class="ce-slot-icon-box"><img
                                            src="https://media.dsrwiki.com/dsrwiki/item/신발 슬롯.webp" class="ce-slot-img"
                                            alt="신발 슬롯"></div>
                                    <span class="ce-slot-text" data-en="Shoes Slot">신발 슬롯</span>
                                </button>
                                <button class="ce-slot-btn" data-slot="등 슬롯">
                                    <div class="ce-slot-icon-box"><img
                                            src="https://media.dsrwiki.com/dsrwiki/item/등 슬롯.webp" class="ce-slot-img"
                                            alt="등 슬롯"></div>
                                    <span class="ce-slot-text" data-en="Back Slot">등 슬롯</span>
                                </button>
                            </div>

                            <!-- Right Content Area -->
                            <div class="ce-content">
                                <div class="ce-current-header">
                                    <div class="ce-current-icon-box"><img
                                            src="https://media.dsrwiki.com/dsrwiki/item/머리 슬롯.webp" class="ce-slot-img"
                                            id="current-slot-icon" alt="current slot"></div>
                                    <div class="ce-current-title"><span id="current-slot-name" data-en="Head Slot">머리 슬롯</span></div>
                                </div>

                                <div class="ce-section">
                                    <div class="ce-section-title" data-en="Materials">소모 재료</div>
                                    <div class="ce-material-list" id="ce-material-list">
                                        <div class="ce-material-item">
                                            <div class="ce-mat-icon amulet"><img
                                                    src="https://media.dsrwiki.com/dsrwiki/icon.webp"
                                                    style="width:20px;opacity:0.5;" alt="amulet"></div>
                                            <span class="ce-mat-name">능력치 각인 부적</span>
                                            <span class="ce-mat-count red">0 / 5</span>
                                        </div>
                                        <div class="ce-material-item">
                                            <div class="ce-mat-icon"><img
                                                    src="https://media.dsrwiki.com/dsrwiki/icon.webp"
                                                    style="width:20px;opacity:0.5;filter:hue-rotate(90deg);" alt="bell">
                                            </div>
                                            <span class="ce-mat-name">능력치 잠금 방울</span>
                                            <span class="ce-mat-count green">0 / 0</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="ce-section" style="flex:1;">
                                    <div class="ce-stats-header"><span data-en="Locks left">잠금 가능 횟수</span> : <span id="ce-lock-count">2</span>
                                        &nbsp;/&nbsp; 2</div>
                                    <div class="ce-stat-list" id="ce-stat-list">
                                        <div class="ce-stat-row">
                                            <span class="ce-stat-name">바람 데미지 증가</span>
                                            <div class="ce-stat-value-wrap">
                                                <span class="ce-stat-value">+1.93%</span>
                                                <i class="ri-lock-unlock-fill ce-stat-lock"></i>
                                            </div>
                                        </div>
                                        <div class="ce-stat-row">
                                            <span class="ce-stat-name">빛 데미지 증가</span>
                                            <div class="ce-stat-value-wrap">
                                                <span class="ce-stat-value">+1.82%</span>
                                                <i class="ri-lock-unlock-fill ce-stat-lock"></i>
                                            </div>
                                        </div>
                                        <div class="ce-stat-row">
                                            <span class="ce-stat-name">빛 데미지 방어</span>
                                            <div class="ce-stat-value-wrap">
                                                <span class="ce-stat-value">+1.32%</span>
                                                <i class="ri-lock-unlock-fill ce-stat-lock"></i>
                                            </div>
                                        </div>
                                        <div class="ce-stat-row">
                                            <span class="ce-stat-name">지능</span>
                                            <div class="ce-stat-value-wrap">
                                                <span class="ce-stat-value">+11</span>
                                                <i class="ri-lock-unlock-fill ce-stat-lock"></i>
                                            </div>
                                        </div>
                                        <div class="ce-stat-row">
                                            <span class="ce-stat-name">빛 데미지 증가</span>
                                            <div class="ce-stat-value-wrap">
                                                <span class="ce-stat-value">+1.83%</span>
                                                <i class="ri-lock-unlock-fill ce-stat-lock"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="ce-footer">
                                    <div class="ce-cost">
                                        <span data-en="Total cost">누적 소모 비용</span> : <span class="ce-cost-value" id="ce-cost-value">400000</span>
                                        <img class="ce-cost-icon" src="https://media.dsrwiki.com/dsrwiki/bit.webp"
                                            alt="bit">
                                    </div>
                                    <div class="ce-actions">
                                        <button class="ce-engrave-btn" id="ce-engrave-btn" data-en="Stat mod">능력치 각인</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Modal -->
    <div id="ce-stats-modal" class="ce-stats-modal-overlay" style="display: none;">
        <div class="ce-stats-modal">
            <button class="ce-stats-close-btn" id="ce-stats-close-btn"><i class="ri-close-line"></i></button>
            <h3 class="ce-stats-title" data-en="Total Statistics">총 누적 통계</h3>

            <div class="ce-stats-content">
                <div class="ce-stats-col">
                    <div class="ce-stats-section">
                        <div class="ce-stats-section-title" data-en="Total Cost">누적 소모 비용</div>
                        <div class="ce-stats-cost-value">
                            <span id="total-cost-value">0</span>
                            <img src="https://media.dsrwiki.com/dsrwiki/bit.webp"
                                style="height:18px;margin-left:4px;vertical-align:middle;object-fit:contain;">
                        </div>
                    </div>

                    <div class="ce-stats-section" style="flex:1;">
                        <div class="ce-stats-section-title" data-en="Total Materials (all slots)">누적 소모 재료 (부위별 합산)</div>
                        <div class="ce-stats-mat-wrap" id="total-mats-list">
                        </div>
                    </div>
                </div>

                <div class="ce-stats-col ce-stats-col-right">
                    <div class="ce-stats-section" style="flex:1;">
                        <div class="ce-stats-section-title" data-en="Applied Options (all slots)">적용된 옵션 합산 (전체 부위)</div>
                        <div class="ce-stats-opts-wrap" id="total-stats-list">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

  <script>
    import { onPage } from '../scripts/page.js';
    import { init } from '../scripts/costume-slot.js';
    import { applyStatic } from '../scripts/i18n.js';
    onPage('costume-slot', () => applyStatic(document, 'Costume Slot Mod'), init);
  </script>
</Layout>
