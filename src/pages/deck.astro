---
// 기존 deck.html 을 옮긴 페이지
import Layout from '../layouts/Layout.astro';
// CSS 는 빌드할 때 압축해서 페이지 안에 넣음 (순서 = 예전 <link> 순서 그대로)
import '../styles/pages/deck/main.css';
import '../styles/styles1.css';
---
<Layout title="덱">

  <div class="container">
    <div class="search-container">
      <div class="search-row">
        <div class="search-group">
          <label for="digimon-search" data-en="Search Digimon">디지몬 검색</label>
          <input type="text" id="digimon-search" placeholder="디지몬 이름 입력...">
        </div>

        <div class="search-group">
          <label for="effect-search" data-en="Search Effects">효과 검색</label>
          <input type="text" id="effect-search" placeholder="효과 키워드 입력...">
        </div>
      </div>
    </div>

    <div id="deck-container" class="deck-container">
      <!-- 덱 카드들이 여기에 동적으로 추가됩니다 -->
    </div>
  </div>

  <script>
    import { onPage } from '../scripts/page.js';
    import { init } from '../scripts/deck.js';
    import { applyStatic, t } from '../scripts/i18n.js';
    onPage('deck', () => {
      applyStatic(document, 'Deck');
      document.getElementById('digimon-search').placeholder = t('디지몬 이름 입력...', 'Digimon name...');
      document.getElementById('effect-search').placeholder = t('효과 키워드 입력...', 'Effect keyword...');
    }, init);
  </script>
</Layout>
