---
// 기존 deck.html 을 옮긴 페이지
import Layout from '../layouts/Layout.astro';
---
<Layout title="덱">
  <Fragment slot="head">
    <link rel="stylesheet" href="/assets/css/pages/deck/main.css" />
    <link rel="stylesheet" href="/assets/css/styles1.css?p=deck" />
  </Fragment>

  <div class="container">
    <div class="search-container">
      <div class="search-row">
        <div class="search-group">
          <label for="digimon-search">디지몬 검색</label>
          <input type="text" id="digimon-search" placeholder="디지몬 이름 입력...">
        </div>

        <div class="search-group">
          <label for="effect-search">효과 검색</label>
          <input type="text" id="effect-search" placeholder="효과 키워드 입력...">
        </div>
      </div>
    </div>

    <div id="deck-container" class="deck-container">
      <!-- 덱 카드들이 여기에 동적으로 추가됩니다 -->
    </div>
  </div>

  <script>
    import { onPage } from '../scripts/page.js';
    import { init } from '../scripts/deck.js';
    onPage('deck', init);
  </script>
</Layout>
