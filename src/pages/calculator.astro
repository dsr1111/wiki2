---
// 기존 calculator.html 을 옮긴 페이지
import Layout from '../layouts/Layout.astro';
// CSS 는 빌드할 때 압축해서 페이지 안에 넣음 (순서 = 예전 <link> 순서 그대로)
import '../styles/styles1.css';
import '../styles/pages/calculator/main.css';
import '../styles/pages/calculator/layout.css';
---
<Layout title="데미지 계산기">

<main class="calculator-shell">
  <div id="status" role="status" data-en="Loading Digimon and monster data.">디지몬과 몬스터 정보를 불러오는 중입니다.</div>
  <form id="calculator-form" hidden>
  <div class="workspace">
    <div class="setup">
      <div class="combatants">
        <section class="panel" aria-labelledby="attacker-title">
          <div class="section-heading"><h2 id="attacker-title" data-en="My Digimon">내 디지몬</h2><label class="toggle" data-en="Manual Input"><input type="checkbox" id="manual-mode">수동 입력</label></div>
          <div id="normal-inputs">
            <div class="form-grid"><label data-en="Evolution Stage">진화 단계<select id="stage-select"><option value="성장기" data-en="Rookie">성장기</option><option value="성숙기" data-en="Champion">성숙기</option><option value="완전체" data-en="Ultimate">완전체</option><option value="궁극체" data-en="Mega">궁극체</option></select></label><label data-en="Digimon">디지몬<select id="character-select"></select></label></div>
            <div class="portrait-row"><div class="portrait" id="character-image-cell"></div><div><strong id="character-name"></strong><div class="identity" id="character-meta"></div><p class="base-stat">기본 힘 <b id="힘-cell"></b></p></div></div>
            <div class="skill-fields"><label data-en="Skill">사용 스킬<select id="skill-select"></select></label><label data-en="Skill Level">스킬 레벨<select id="skilllevel-select"></select></label></div>
            <fieldset class="element-field"><legend data-en="Skill Attribute">스킬 속성</legend><div id="element-options" class="element-options"></div><select id="skill-element" hidden aria-label="계산에 사용할 스킬 속성"></select></fieldset>
          </div>
          <div id="manual-inputs" hidden><p class="helper manual-hint" data-en="Calculates with the values below instead of Digimon data.">디지몬 데이터 대신 아래에 입력한 수치로 계산합니다.</p><div class="form-grid">
            <label data-en="Type">타입<select id="manual-type"><option value="백신" data-en="Vaccine">백신</option><option value="바이러스" data-en="Virus">바이러스</option><option value="데이터" data-en="Data">데이터</option><option value="프리" data-en="Free">프리</option><option value="언노운" data-en="Unknown">언노운</option></select></label>
            <label data-en="Level">레벨<input id="manual-level" type="number" min="1" max="1000" value="100" required></label>
            <label data-en="Base STR">기본 힘<input id="manual-power" type="number" min="0" value="0" required></label>
            <label data-en="Skill Coefficient (%)">스킬 계수 (%)<input id="manual-skill-coefficient" type="number" min="0.01" value="100" step="0.01" required></label>
            <label data-en="Skill Hits">스킬 타수<input id="manual-hit-count" type="number" min="1" max="100" value="1" required></label>
            <label data-en="Skill Target">스킬 대상<select id="manual-target-type"><option value="단일" data-en="Single">단일</option><option value="전체" data-en="All">전체</option></select></label>
            <label class="full" data-en="Skill Attribute">스킬 속성<select id="manual-skill-element"></select></label>
          </div></div>
        </section>
        <section class="panel" aria-labelledby="enemy-title">
          <div class="section-heading"><h2 id="enemy-title" data-en="Enemy Digimon">악역 디지몬</h2></div>
          <div class="form-grid"><label data-en="Region">출현 지역<select id="map1-select"></select></label><label data-en="Map">맵<select id="map2-select"></select></label><label class="full" data-en="Monster">몬스터<select id="mob-select"></select></label></div>
          <div class="portrait-row"><div class="portrait" id="mob-image-cell"></div><div><strong id="mob-name"></strong><div class="identity" id="mob-meta"></div></div></div>
          <dl class="enemy-stats"><div><dt data-en="HP">체력</dt><dd id="mob-hp"></dd></div><div><dt data-en="DEF">수비</dt><dd id="mob-def"></dd></div><div><dt data-en="Weakness">약점</dt><dd id="mob-weak"></dd></div><div><dt data-en="Resistance">내성</dt><dd id="mob-strong"></dd></div></dl>
        </section>
      </div>
      <section class="panel modifiers" aria-labelledby="modifiers-title">
        <div class="section-heading"><h2 id="modifiers-title" data-en="Extra Modifiers">추가 보정</h2><button id="reset" class="quiet-button" type="button" data-en="Reset">입력 초기화</button></div>
        <div class="modifier-grid">
          <div class="modifier-group"><h3 data-en="STR Stat">힘 스탯</h3><div class="form-grid">
            <label data-en="Potential">포텐셜<span class="number-field"><input id="potential" type="number" min="0" step="any" placeholder="0"><span>%</span></span></label>
            <label data-en="Baby Correction">유년기 교정<span class="number-field"><input id="correction" type="number" min="0" step="any" placeholder="0"><span>%</span></span></label>
            <label data-en="Synergy">시너지<input id="synergy" type="number" min="0" step="any" placeholder="0"></label><label data-en="Buff">버프<input id="buff" type="number" min="0" step="any" placeholder="0"></label>
            <label data-en="Specialized">특화<input id="specialization" type="number" min="0" step="any" placeholder="0"></label><label data-en="Gear+Costume">장비+코스튬<input id="equipment1" type="number" min="0" step="any" placeholder="0"></label>
          </div></div>
          <div class="modifier-group"><h3 data-en="Attribute Bonus Damage">속성 추가 데미지</h3><div class="form-grid">
            <label data-en="Gear">장비<span class="number-field"><input id="equipment2" type="number" min="0" step="any" placeholder="0"><span>%</span></span></label>
            <label data-en="Mod">각인<span class="number-field"><input id="engraving" type="number" min="0" step="any" placeholder="0"><span>%</span></span></label>
          </div></div>
        </div>
        <section class="advanced" aria-labelledby="advanced-title"><h3 id="advanced-title" class="advanced-heading" data-en="Critical · Damage Range">크리티컬 · 데미지 범위</h3><div class="advanced-grid">
          <label data-en="Crit Rate (%)">크리티컬 확률 (%)<input id="crit-rate" type="number" min="0" max="100" step="any" placeholder="0"></label>
          <label data-en="Crit Damage (%)">크리티컬 데미지율 (%)<input id="crit-dmg" type="number" min="0.01" step="any" placeholder="150"></label>
          <label data-en="Min Damage (%)">데미지 최소 (%)<input id="dmg-min" type="number" min="0.01" step="any" placeholder="95"></label>
          <label data-en="Max Damage (%)">데미지 최대 (%)<input id="dmg-max" type="number" min="0.01" step="any" placeholder="105"></label>
        </div></section>
      </section>
    </div>
    <aside class="result-panel" aria-labelledby="result-title"><div class="section-heading"><h2 id="result-title" data-en="Result">계산 결과</h2><span class="live-dot" aria-label="실시간 계산"></span></div>
      <div class="form-grid"><label data-en="Number of Mobs">상대 몹 수<select id="mob-count"><option value="1" data-en="1">1마리</option><option value="2" data-en="2">2마리</option><option value="3" data-en="3">3마리</option></select></label><label data-en="Kill Target">처치 기준<select id="skillcount"><option value="1킬" data-en="1 Kill">1킬</option><option value="2킬" data-en="2 Kills">2킬</option><option value="3킬" data-en="3 Kills">3킬</option><option value="4킬" data-en="4 Kills">4킬</option><option value="5킬" data-en="5 Kills">5킬</option></select></label></div>
      <div class="probability" aria-live="polite" aria-atomic="true"><p data-en="Kill Chance">처치 확률</p><strong id="needstr" data-en="Calculating">계산 중</strong><div class="probability-track"><span id="probability-bar"></span></div><p id="result-caption" class="helper" hidden></p></div>
      <dl class="result-stats"><div><dt data-en="Final STR">최종 힘</dt><dd id="str-result">0</dd></div><div><dt data-en="Attribute Used">적용 속성</dt><dd id="result-element">-</dd></div><div><dt data-en="Coefficient / Hit">적용 계수 / 타격</dt><dd id="result-coefficient">-</dd></div></dl>
      <div class="damage-summary"><h3 data-en="Total Damage Range per Skill">스킬 1회 총 데미지 범위</h3><p><span data-en="All Normal Hits">모두 일반 타격</span><strong id="normal-damage">-</strong></p><p><span data-en="All Critical">모두 크리티컬</span><strong id="critical-damage">-</strong></p><p class="damage-caveat" data-en="Monster critical damage reduction is unknown, so actual damage may differ.">몬스터의 크리티컬 데미지 감소율 정보가 없어 실제 데미지와 다를 수 있습니다.</p></div>
    </aside>
  </div>
  </form>
</main>

  <script>
    import { onPage } from '../scripts/page.js';
    import { init } from '../scripts/calculator.js';
    import { applyStatic } from '../scripts/i18n.js';
    onPage('calculator', () => applyStatic(document, 'Damage Calculator'), init);
  </script>
</Layout>
