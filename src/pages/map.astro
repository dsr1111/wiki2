---
// 기존 map.html 을 옮긴 페이지
import Layout from '../layouts/Layout.astro';
// CSS 는 빌드할 때 압축해서 페이지 안에 넣음 (순서 = 예전 <link> 순서 그대로)
import '../styles/pages/map/main.css';
import '../styles/styles1.css';
---
<Layout title="맵">

  <div class="container1" style="position: relative" ;>
    <div class="main">
      <p>지도</p>
      <div class="dropdown">
        <div class="dropdown-con">
          <select id="con-dropdown">
            <option value="파일섬" selected>파일섬</option>
            <option value="서버대륙">서버대륙</option>
            <option value="현실 세계">현실 세계</option>
            <option value="스파이럴 마운틴">스파이럴 마운틴</option>
            <option value="데이터 세계">데이터 세계</option>
            <option value="파워디지몬 PART1">파워디지몬 PART1</option>
          </select>
        </div>
        <div class="dropdown-map">
          <select id="map-dropdown">

          </select>
        </div>
        <button class="dropdown-icon">
          아이콘 필터 <span class="arrow">▼</span>
        </button>
        <div class="dropdown-content" id="dropdown-content"></div>
      </div>
      <!-- 드랍 아이템 제보 안내: 드랍 정보가 없는 몹이 있는 지역(지금은 파워디지몬 PART1)에서만 보임 (scripts/map.js) -->
      <div class="map-notice" id="drop-notice" hidden>
        <span>파워디지몬 PART1 악역 디지몬의 드랍 아이템은 아직 확인 중이에요. 얻은 아이템을 제보해 주세요!</span>
        <button type="button" id="drop-report">제보하기</button>
      </div>
    </div>

    <div id="image-container">
    </div>
  </div>
  <!-- (Astro) 기존 map.html 에 짝 없는 </div> 가 하나 더 있었음. 브라우저는 무시하지만 Astro 는 오류를 내므로 제거 -->

  <script>
    import { onPage } from '../scripts/page.js';
    import { init } from '../scripts/map.js';
    onPage('map', init);
  </script>
</Layout>
